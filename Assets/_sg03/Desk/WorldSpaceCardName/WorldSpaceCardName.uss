.card-name-root {
    width: 640px;
    height: 100px;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    justify-content: center;
    align-items: center;
}

.card-name-container {
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    justify-content: center;
    align-items: center;
}

.card-name-label {
    -unity-font-definition: url("project://database/Assets/_sg03/Card/Font/CinzelDecorative/CinzelDecorative-Bold.ttf");
    -unity-font: url("project://database/Assets/_sg03/Card/Font/CinzelDecorative/CinzelDecorative-Bold.ttf");
    color: rgb(248, 218, 156);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2.8px;
    -unity-text-outline-color: rgba(8, 4, 14, 0.98);
    text-shadow: 0 0 10px rgba(255, 105, 18, 0.75);
    letter-spacing: 1.5px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    white-space: normal;
}

