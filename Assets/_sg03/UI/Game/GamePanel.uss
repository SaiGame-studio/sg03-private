@import url("../Common/Variables.uss");

.game-root {
    flex: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
}

.game-viewport {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    background-color: transparent;
}

.game-top-menu {
    flex-direction: row;
    align-items: center;
    height: 56px;
    min-height: 56px;
    background-color: rgba(16, 20, 36, 0.92);
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 0 20px;
}

.game-top-menu__title {
    font-size: 16px;
    color: rgb(200, 210, 255);
    -unity-font-style: bold;
    margin-right: 24px;
    letter-spacing: 1px;
}

.game-top-menu__tabs {
    flex-direction: row;
    align-items: center;
}

.game-bottom-menu__desk-info {
    flex: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.game-bottom-menu__desk-info .game-top-menu__tabs {
    flex: 1;
    min-width: 0;
    overflow: hidden;
}

.game-bottom-menu__desk-info .game-top-menu__card-count {
    flex: 0 0 auto;
    margin-right: 8px;
}

.game-bottom-menu__turn-info {
    flex: 0 0 auto;
    min-width: 140px;
    margin-left: auto;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
}

.game-bottom-menu__move-label {
    font-size: 13px;
    margin-right: 0;
    margin-bottom: 1px;
    -unity-text-align: middle-right;
}

.game-bottom-menu__turn-label {
    color: rgb(150, 160, 200);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

#PlayerNavigation {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.soul-energy {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

.soul-energy__icon {
    width: 11px;
    height: 11px;
    color: rgb(210, 190, 255);
    margin-right: 4px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(210, 190, 255);
    background-color: transparent;
    transition-duration: 0.12s;
}

.soul-energy__value {
    color: rgb(214, 207, 240);
    font-size: 10px;
    transition-duration: 0.12s;
}

.soul-energy:hover {
    background-color: transparent;
}

.soul-energy:hover .soul-energy__icon,
.soul-energy:hover .soul-energy__value {
    color: rgb(255, 220, 128);
}

.soul-energy:hover .soul-energy__icon {
    border-color: rgb(255, 220, 128);
}

.soul-energy-popup {
    position: absolute;
    width: 164px;
    padding: 9px 10px;
    background-color: rgb(23, 19, 42);
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(132, 94, 255, 0.7);
}

.soul-energy-popup__title {
    color: rgb(222, 212, 255);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.soul-energy-popup__row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2px;
}

.soul-energy-popup__label {
    color: rgb(164, 155, 196);
    font-size: 11px;
}

.soul-energy-popup__value {
    color: rgb(235, 229, 255);
    font-size: 11px;
    -unity-font-style: bold;
    margin-left: 14px;
}

.game-tab {
    padding: 8px 18px;
    border-radius: 8px;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    margin-right: 4px;
    transition-duration: 0.12s;
}

.game-tab:hover {
    background-color: rgba(80, 100, 160, 0.25);
    color: rgb(200, 215, 255);
}

.game-tab--active {
    background-color: rgba(60, 110, 230, 0.25);
    color: rgb(110, 160, 255);
    -unity-font-style: bold;
}

.game-tab--loader {
    background-color: rgba(38, 46, 68, 0.86);
    color: rgb(210, 220, 245);
}

.game-tab--loader:hover {
    background-color: rgba(58, 68, 96, 0.92);
    color: rgb(240, 244, 255);
}

.game-top-menu__player-name {
    font-size: 13px;
    color: rgb(180, 195, 240);
    -unity-font-style: bold;
    margin-left: 16px;
    -unity-text-align: middle-right;
}

.game-top-menu__card-count {
    min-width: 112px;
    font-size: 13px;
    color: rgb(220, 228, 255);
    -unity-font-style: bold;
    margin-left: 16px;
    -unity-text-align: middle-right;
}

.game-world-view-space {
    flex: 1;
    width: 100%;
    position: relative;
    background-color: transparent;
}

.battle-hp-label {
    position: absolute;
    left: 18px;
    min-width: 132px;
    padding: 8px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.42);
    background-color: rgba(16, 20, 36, 0.82);
    color: rgb(235, 240, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.battle-hp-label--omega {
    top: 18px;
}

.battle-hp-label--alpha {
    bottom: 18px;
}

.battle-source-count-label {
    position: absolute;
    right: 18px;
    min-width: 132px;
    padding: 8px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.42);
    background-color: rgba(16, 20, 36, 0.82);
    color: rgb(235, 240, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.battle-source-count-label--top-right {
    top: 18px;
}

.battle-source-count-label--top-right-2 {
    top: 72px;
}

.battle-source-count-label--bottom-right {
    bottom: 18px;
}

.battle-source-count-label--bottom-right-2 {
    bottom: 72px;
}

.battle-source-count-label--interactive {
    transition-duration: 0.12s;
}

.battle-source-count-label--interactive:hover {
    border-color: rgba(110, 150, 255, 0.95);
    background-color: rgba(35, 48, 82, 0.94);
    color: rgb(255, 255, 255);
}

.void-grid-panel {
    width: 72%;
    height: 72%;
    min-width: 520px;
    min-height: 360px;
    padding: 18px;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgba(100, 130, 220, 0.65);
    background-color: rgba(16, 20, 36, 0.98);
}

.void-grid-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.void-grid-title {
    flex-grow: 1;
    color: rgb(225, 233, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.void-grid-close-button {
    width: 36px;
    height: 32px;
    padding: 0;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(180, 30, 30, 0.85);
    color: rgb(255, 235, 235);
    -unity-font-style: bold;
}

.void-grid-close-button:hover {
    background-color: rgba(220, 50, 50, 1);
}

.void-grid-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.void-grid-sort-field {
    flex-grow: 1;
    max-width: 380px;
    color: rgb(220, 228, 255);
}

.void-grid-sort-field > .unity-base-field__label {
    min-width: 42px;
    color: rgb(180, 195, 240);
    -unity-font-style: bold;
}

.void-grid-sort-field .unity-base-popup-field__input,
.void-grid-sort-field .unity-popup-field__input {
    min-height: 32px;
    padding: 4px 10px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(80, 100, 160, 0.55);
    background-color: rgba(38, 46, 68, 0.92);
    color: rgb(220, 228, 255);
}

.void-grid-sort-field .unity-base-popup-field__input:hover,
.void-grid-sort-field .unity-popup-field__input:hover {
    border-color: rgba(100, 140, 255, 0.9);
    background-color: rgba(58, 68, 96, 0.96);
}

.void-grid-sort-field .unity-base-popup-field__text,
.void-grid-sort-field .unity-popup-field__text {
    color: rgb(220, 228, 255);
    -unity-font-style: bold;
}

.void-grid-sort-field .unity-base-popup-field__arrow,
.void-grid-sort-field .unity-popup-field__arrow {
    -unity-background-image-tint-color: rgb(150, 180, 255);
}

.void-grid-content {
    flex-grow: 1;
    min-height: 0;
}

.void-grid-row {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.void-grid-card,
.void-grid-card-placeholder {
    flex-shrink: 0;
    min-width: 0;
    margin: 5px;
}

.void-grid-card {
    padding: 12px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(80, 110, 190, 0.55);
    background-color: rgba(31, 39, 65, 0.96);
    justify-content: center;
}

.void-grid-card-art {
    flex-grow: 1;
    min-height: 0;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background-color: rgba(13, 17, 30, 0.9);
}

.void-grid-card-art-image {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.void-grid-card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    min-height: 12px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0.68);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.void-grid-card-overlay > .unity-label {
    margin: 0;
    padding: 0;
}

.void-grid-card-overlay--top {
    top: 0;
    align-items: flex-start;
}

.void-grid-card-overlay--bottom {
    bottom: 0;
    align-items: flex-end;
}

.void-grid-card-overlay-name {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: upper-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.void-grid-card-overlay-stars {
    flex-shrink: 0;
    color: rgb(255, 214, 72);
    -unity-text-align: upper-right;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.void-grid-card-overlay-stat {
    flex-grow: 1;
    width: 50%;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.void-grid-card-overlay-stat--attack {
    -unity-text-align: lower-left;
}

.void-grid-card-overlay-stat--defense {
    -unity-text-align: lower-right;
}

.void-grid-empty-label {
    flex-grow: 1;
    color: rgb(150, 160, 195);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.void-grid-footer {
    height: 42px;
    min-height: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
}

.void-grid-page-button {
    min-width: 100px;
    padding: 8px 14px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(55, 79, 145, 0.9);
    color: rgb(235, 240, 255);
    -unity-font-style: bold;
}

.void-grid-page-button:hover {
    background-color: rgba(72, 105, 190, 1);
}

.void-grid-page-label {
    min-width: 120px;
    margin: 0 16px;
    color: rgb(190, 204, 240);
    -unity-text-align: middle-center;
}

.game-bottom-menu {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    height: 45px;
    min-height: 45px;
    background-color: rgba(16, 20, 36, 0.92);
    border-top-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 0 12px;
}

.game-bottom-menu #BtnStartBattle {
    flex: 0 0 132px;
    width: 132px;
    min-width: 132px;
    max-width: 132px;
    margin: 0 8px;
    padding: 10px 8px;
}

.game-bottom-menu #BtnEndBattle {
    flex: 0 0 132px;
    width: 132px;
    min-width: 132px;
    max-width: 132px;
    margin: 0 8px;
    padding: 10px 8px;
}

.game-bottom-menu #BtnCancelLastGame {
    flex: 0 0 164px;
    width: 164px;
    min-width: 164px;
    max-width: 164px;
    margin: 0 8px;
    padding: 10px 8px;
}

.game-bottom-btn {
    flex: 1;
    margin: 0 6px;
    padding: 10px 8px;
    border-radius: 10px;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    transition-duration: 0.12s;
    -unity-text-align: middle-center;
}

.game-bottom-btn:hover {
    background-color: rgba(80, 100, 160, 0.25);
    color: rgb(200, 215, 255);
}

.game-bottom-input {
    flex: 1.25;
    margin: 0 6px;
    min-width: 160px;
    color: rgb(220, 228, 255);
    font-size: 13px;
}

.game-bottom-input .unity-label {
    min-width: 46px;
    color: rgb(180, 195, 240);
    -unity-font-style: bold;
}

.game-bottom-input .unity-text-input {
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.45);
    background-color: rgba(38, 46, 68, 0.86);
    color: rgb(240, 244, 255);
    padding: 6px 8px;
}

.game-bottom-btn--secondary {
    background-color: rgba(38, 46, 68, 0.86);
    color: rgb(210, 220, 245);
}

.game-bottom-btn--secondary:hover {
    background-color: rgba(58, 68, 96, 0.92);
    color: rgb(240, 244, 255);
}

.game-bottom-btn--danger {
    background-color: rgba(180, 30, 30, 0.85);
    color: rgb(255, 220, 220);
    -unity-font-style: bold;
}

.game-bottom-btn--danger:hover {
    background-color: rgba(220, 50, 50, 1);
    color: rgb(255, 240, 240);
}

.game-bottom-btn--primary {
    background-color: rgba(60, 110, 230, 1);
    color: rgb(240, 244, 255);
    -unity-font-style: bold;
}

.game-bottom-btn--primary:hover {
    background-color: rgba(80, 130, 255, 1);
}

/* Enemy input and Start Battle button placed inside TopMenu — compact size */
.game-top-menu .game-bottom-input {
    flex: 0 0 280px;
    width: 280px;
    min-width: 280px;
    max-width: 280px;
    font-size: 11px;
    margin: 0 4px;
}

.game-top-menu .game-bottom-input .unity-text-input {
    padding: 2px 6px;
    color: rgb(180, 0, 0);
}

/* Enemy selector: match the dark, blue-accented controls in the top menu. */
.game-top-menu .game-bottom-input .unity-base-popup-field__input,
.game-top-menu .game-bottom-input .unity-popup-field__input {
    min-height: 28px;
    padding: 2px 8px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(80, 100, 160, 0.45);
    background-color: rgba(38, 46, 68, 0.86);
    color: rgb(220, 228, 255);
}

.game-top-menu .game-bottom-input .unity-base-popup-field__input:hover,
.game-top-menu .game-bottom-input .unity-popup-field__input:hover {
    border-color: rgba(100, 140, 255, 0.9);
    background-color: rgba(58, 68, 96, 0.92);
}

.game-top-menu .game-bottom-input .unity-base-popup-field__text,
.game-top-menu .game-bottom-input .unity-popup-field__text {
    color: rgb(220, 228, 255);
    -unity-font-style: bold;
}

.game-top-menu .game-bottom-input .unity-base-popup-field__arrow,
.game-top-menu .game-bottom-input .unity-popup-field__arrow {
    -unity-background-image-tint-color: rgb(150, 180, 255);
}

.game-top-menu .game-bottom-btn--primary {
    flex: 0 0 auto;
    padding: 4px 10px;
    font-size: 11px;
    margin: 0 4px;
}

#BtnBackToLobby {
    flex: 0 0 auto;
    width: 70px;
    min-width: 70px;
    max-width: 70px;
}

/* Battle Result Popup Styles */
.battle-result-popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 8, 16, 0.88);
    align-items: center;
    justify-content: center;
}

.battle-result-popup-card {
    min-width: 380px;
    padding: 36px;
    background-color: rgba(22, 26, 40, 0.98);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.4);
    align-items: center;
}

.battle-result-popup-title {
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    -unity-text-align: center;
}

.battle-result-popup-title--win {
    color: rgb(0, 255, 136);
}

.battle-result-popup-title--loss {
    color: rgb(255, 76, 76);
}

.battle-result-popup-message {
    font-size: 15px;
    color: rgb(180, 195, 240);
    margin-bottom: 32px;
    -unity-text-align: center;
}

.battle-result-popup-btn-row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.battle-result-popup-btn {
    flex: 1;
    margin: 0 10px;
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-duration: 0.15s;
    border-width: 0;
}

.battle-result-popup-btn--continue {
    background-color: rgba(60, 110, 230, 1);
    color: rgb(240, 244, 255);
}

.battle-result-popup-btn--continue:hover {
    background-color: rgba(80, 130, 255, 1);
}

.battle-result-popup-btn--stop {
    background-color: rgba(180, 30, 30, 0.85);
    color: rgb(255, 220, 220);
}

.battle-result-popup-btn--stop:hover {
    background-color: rgba(220, 50, 50, 1);
}
